{
  "name": "opencode-account-rotate",
  "version": "0.0.1",
  "description": "Native OpenAI account rotation on confirmed quota exhaustion for OpenCode V2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "format": "prettier --write src package.json tsconfig.json README.md"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.32"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.32",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
