{
  "name": "opencode-account-rotate",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Native OpenAI account rotation on confirmed quota exhaustion for OpenCode V2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanthropic/opencode-account-rotate.git"
  },
  "homepage": "https://github.com/shanthropic/opencode-account-rotate#readme",
